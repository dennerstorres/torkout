{
  "name": "@torkout/web",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm typecheck && vite build",
    "dev": "vite --host 0.0.0.0",
    "generate:icons": "node ../../scripts/generate-pwa-icons.mjs",
    "preview": "vite preview --host 0.0.0.0",
