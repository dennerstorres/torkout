NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://torkout:torkout_dev_only@localhost:15433/torkout
TEST_DATABASE_URL=postgresql://torkout_test:torkout_test@localhost:15432/torkout_test
LOG_LEVEL=info
# Diretório do driver local de armazenamento de objetos (fotos de evolução).
# Em produção, aponte para um volume persistente; um driver S3 pode substituí-lo depois.
OBJECT_STORAGE_DIR=./var/object-storage
TRUST_PROXY=127.0.0.1,::1
AUTH_BASE_URL=http://localhost:5173
AUTH_SECRET=torkout-local-development-secret-change-before-any-deployment
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:4173
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=local-test-user
SMTP_PASSWORD=local-test-password
SMTP_FROM=Torkout <no-reply@torkout.local>
# Cadastro público. O padrão do produto é fechado; o desenvolvimento local mantém aberto para que o
# fluxo completo continue exercitável. Habilitar em uma instância exposta significa assumir a
# responsabilidade pelos dados de saúde de quem se cadastrar. As duas variáveis precisam concordar:
# a primeira decide na API, a segunda decide o que a tela de entrada oferece.
PUBLIC_SIGNUP_ENABLED=true
VITE_PUBLIC_SIGNUP_ENABLED=true
VITE_API_BASE_URL=/api/v1
# Integração MCP somente leitura, para que um cliente externo — ChatGPT, Claude — consulte os dados
# registrados. O padrão é desligado: habilitar significa aceitar que um serviço de terceiro leia
# dados de saúde mediante autorização explícita do titular. Nenhuma ferramenta escreve.
# `MCP_PUBLIC_URL` é opcional; ausente, o servidor usa `AUTH_BASE_URL`. Use um subdomínio dedicado
# como https://mcp.seu-dominio quando o proxy encaminhar /mcp e /oauth para a API.
# Não existe token estático: as credenciais são emitidas pelo fluxo OAuth 2.1 e guardadas como hash.
MCP_ENABLED=false
MCP_PUBLIC_URL=
