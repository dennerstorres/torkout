{
  "name": "torkout",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "build": "pnpm --filter @torkout/contracts build && pnpm --filter @torkout/domain build && pnpm --filter @torkout/database build && pnpm --filter @torkout/test-utils build && pnpm --filter @torkout/api build && pnpm --filter @torkout/web build",
    "build:packages": "pnpm --filter @torkout/contracts build && pnpm --filter @torkout/domain build && pnpm --filter @torkout/database build && pnpm --filter @torkout/test-utils build",
    "check": "pnpm verify:governance && pnpm verify:phase-1 && pnpm verify:phase-2 && pnpm verify:phase-3 && pnpm verify:phase-4 && pnpm verify:phase-5 && pnpm verify:phase-6 && pnpm verify:phase-7 && pnpm verify:phase-8 && pnpm verify:phase-9 && pnpm verify:phase-10 && pnpm verify:phase-11 && pnpm verify:phase-12 && pnpm verify:phase-13 && pnpm verify:phase-14 && pnpm verify:phase-15 && pnpm security:scan && pnpm format:check && pnpm lint && pnpm build:packages && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx packages/database/src/migrate-cli.ts",
    "dev": "pnpm --parallel --filter @torkout/api --filter @torkout/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --project unit-node --project unit-web",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --project integration",
    "test:restore": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-backup-restore.ps1",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify:governance": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-governance.ps1",
    "verify:phase-1": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-phase-1.ps1",
    "verify:phase-2": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-phase-2.ps1",
    "verify:phase-3": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-phase-3.ps1",
    "verify:phase-4": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-phase-4.ps1",
    "verify:phase-5": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-phase-5.ps1",
    "verify:phase-6": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-phase-6.ps1",
    "verify:phase-7": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-phase-7.ps1",
    "verify:phase-8": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-phase-8.ps1",
    "verify:phase-9": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-phase-9.ps1",
    "verify:phase-10": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-phase-10.ps1",
    "verify:phase-11": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-phase-11.ps1",
    "verify:phase-12": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-phase-12.ps1",
    "verify:phase-13": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-phase-13.ps1",
    "verify:phase-14": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-phase-14.ps1",
    "verify:phase-15": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-phase-15.ps1",
    "verify:release-rollback": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-release-rollback.ps1",
    "verify:schema-freeze": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-schema-freeze.ps1",
    "security:scan": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-security.ps1 -SelfTest"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
